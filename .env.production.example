# Copy to .env.production and fill in real values for a real deployment.
# Never commit .env.production -- .gitignore already excludes it (.env.* except
# *.example, same convention as appsettings.Production.json.example).
#
# Used by: docker compose -f docker-compose.prod.yml --env-file .env.production up -d

# A real, generated password -- unlike local dev, this container does not allow
# an empty root password.
DB_ROOT_PASSWORD=__GENERATE_A_STRONG_PASSWORD__

# Same requirement as appsettings.Production.json.example: a long random secret,
# not reused from dev.
JWT_SECRET_KEY=__GENERATE_A_LONG_RANDOM_SECRET__

EMAIL_HOST=__SMTP_HOST__
EMAIL_PORT=587
EMAIL_USERNAME=__SMTP_USERNAME__
EMAIL_PASSWORD=__SMTP_PASSWORD__
EMAIL_FROM=noreply@__YOUR_DOMAIN__

# The public origin this deployment is served from -- used both as the link base
# for outgoing emails (Frontend__BaseUrl) and the one origin the API's CORS policy
# allows (Cors__AllowedOrigins__0). The browser only ever calls this same origin
# directly anyway (nginx proxies /api/ internally), so this mostly matters for
# any request that isn't proxied.
PUBLIC_BASE_URL=https://__YOUR_DOMAIN__

# Optional -- the app runs correctly with these unset, it just disables AI product
# creation / AI image editing respectively (see UnavailableProductAiConversationClient
# / UnavailableProductImageEditingClient).
OPENAI_API_KEY=
GEMINI_API_KEY=
